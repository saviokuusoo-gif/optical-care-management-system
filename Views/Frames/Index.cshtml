@model IEnumerable<optical_care_management_system.Models.Frame>

@{
    ViewData["Title"] = "Eyeglass Frames";
    var frames = Model?.ToList() ?? new List<optical_care_management_system.Models.Frame>();

    string? search = ViewBag.Search;
    string? gender = ViewBag.Gender;
    string? shape = ViewBag.Shape;
    string? material = ViewBag.Material;
    string? sort = ViewBag.Sort;
    var minPrice = ViewBag.MinPrice as decimal?;
    var maxPrice = ViewBag.MaxPrice as decimal?;

    var isPatient = User.IsInRole("Patient");
    var isAdmin = User.IsInRole("Admin");
}

@section Styles {
    <link rel="stylesheet" href="~/css/frames.css" asp-append-version="true" />
}

<!-- ================= HERO ================= -->
<section class="hero-section">
    <div class="container">
        <h1>Eyeglass Frames</h1>
        <p>Find the perfect frames for your style and vision.</p>

        <div class="hero-features">
            <div><i class="fa-solid fa-glasses"></i><span>Wide Selection</span></div>
            <div><i class="fa-solid fa-shield-halved"></i><span>Quality Guaranteed</span></div>
            <div><i class="fa-solid fa-truck-fast"></i><span>Fast Delivery</span></div>
        </div>
    </div>
</section>

<div class="container-fluid">
    @if (TempData["Success"] is not null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa fa-circle-check me-1"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">

        <!-- ================= SIDEBAR ================= -->
        <div class="col-lg-3">
            <div class="filter-card">
                <h5><i class="fa-solid fa-sliders text-primary"></i> Filter Frames</h5>

                <form method="get" asp-action="Index">

                    <div class="filter-group">
                        <label class="filter-title" for="searchInput">Search</label>
                        <input type="text" id="searchInput" name="search" value="@search"
                               class="form-control" placeholder="Name or brand" />
                    </div>

                    <div class="filter-group">
                        <span class="filter-title">Gender</span>
                        @foreach (var option in new[] { "", "Men", "Women", "Unisex" })
                        {
                            var id = $"gender-{(option.Length == 0 ? "all" : option.ToLower())}";
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="gender"
                                       id="@id" value="@option"
                                       checked="@(string.Equals(gender ?? string.Empty, option, StringComparison.Ordinal))" />
                                <label class="form-check-label" for="@id">@(option.Length == 0 ? "All" : option)</label>
                            </div>
                        }
                    </div>

                    <div class="filter-group">
                        <label class="filter-title" for="shapeSelect">Frame Shape</label>
                        <select class="form-select" id="shapeSelect" name="shape">
                            <option value="">All Shapes</option>
                            @foreach (var option in new[] { "Round", "Square", "Rectangle", "Cat Eye" })
                            {
                                <option value="@option" selected="@(shape == option)">@option</option>
                            }
                        </select>
                    </div>

                    <div class="filter-group">
                        <label class="filter-title" for="materialSelect">Frame Material</label>
                        <select class="form-select" id="materialSelect" name="material">
                            <option value="">All Materials</option>
                            @foreach (var option in new[] { "Metal", "Plastic", "Titanium", "Acetate", "Mixed Metal" })
                            {
                                <option value="@option" selected="@(material == option)">@option</option>
                            }
                        </select>
                    </div>

                    <div class="filter-group">
                        <span class="filter-title">Price Range</span>
                        <div class="row g-2">
                            <div class="col-6">
                                <input type="number" name="minPrice" step="0.01" min="0"
                                       value="@(minPrice?.ToString() ?? "")"
                                       class="form-control" placeholder="Min" aria-label="Minimum price" />
                            </div>
                            <div class="col-6">
                                <input type="number" name="maxPrice" step="0.01" min="0"
                                       value="@(maxPrice?.ToString() ?? "")"
                                       class="form-control" placeholder="Max" aria-label="Maximum price" />
                            </div>
                        </div>
                    </div>

                    <input type="hidden" name="sort" value="@sort" />

                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fa fa-filter"></i> Apply Filter
                    </button>

                    <a asp-action="Index" class="btn btn-link w-100 mt-1 text-decoration-none">Clear all</a>
                </form>
            </div>
        </div>

        <!-- ================= PRODUCTS ================= -->
        <div class="col-lg-9">

            <div class="frames-toolbar">
                <p class="result-count">
                    Showing <span>@frames.Count</span> frame@(frames.Count == 1 ? "" : "s")
                </p>

                <div class="d-flex align-items-center gap-2">
                    @if (isAdmin)
                    {
                        <a asp-action="Create" class="btn btn-success btn-sm">
                            <i class="fa fa-plus"></i> Add Frame
                        </a>
                    }

                    <form method="get" asp-action="Index" class="d-flex align-items-center gap-2 mb-0">
                        <input type="hidden" name="search" value="@search" />
                        <input type="hidden" name="gender" value="@gender" />
                        <input type="hidden" name="shape" value="@shape" />
                        <input type="hidden" name="material" value="@material" />
                        <input type="hidden" name="minPrice" value="@(minPrice?.ToString() ?? "")" />
                        <input type="hidden" name="maxPrice" value="@(maxPrice?.ToString() ?? "")" />

                        <label class="text-muted small mb-0" for="sortSelect">Sort</label>
                        <select name="sort" id="sortSelect" class="form-select form-select-sm w-auto"
                                onchange="this.form.submit()">
                            <option value="" selected="@(string.IsNullOrEmpty(sort))">Popular</option>
                            <option value="price_low" selected="@(sort == "price_low")">Price: Low to High</option>
                            <option value="price_high" selected="@(sort == "price_high")">Price: High to Low</option>
                            <option value="newest" selected="@(sort == "newest")">Newest</option>
                        </select>
                    </form>
                </div>
            </div>

            @if (!frames.Any())
            {
                <div class="frames-empty">
                    <i class="fa-solid fa-glasses"></i>
                    <h5>No frames match your filters</h5>
                    <p class="mb-3">Try widening your search or clearing the filters.</p>
                    <a asp-action="Index" class="btn btn-outline-primary">Clear filters</a>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var item in frames)
                    {
                        var image = string.IsNullOrWhiteSpace(item.ImageUrl) ? "default-frame.svg" : item.ImageUrl;

                        <div class="col-xxl-3 col-lg-4 col-sm-6">
                            <div class="frame-card">

                                <div class="frame-image">
                                    @if (item.IsAvailable)
                                    {
                                        <span class="frame-badge in-stock">In Stock</span>
                                    }
                                    else
                                    {
                                        <span class="frame-badge out-stock">Sold Out</span>
                                    }

                                    <span class="wishlist" role="button" aria-label="Add to wishlist">
                                        <i class="fa-regular fa-heart"></i>
                                    </span>

                                    @* Fall back to the placeholder if the file is missing. *@
                                    <img src="~/images/frames/@image" alt="@item.Name"
                                         loading="lazy"
                                         onerror="this.onerror=null;this.src='/images/frames/default-frame.svg';" />
                                </div>

                                <div class="card-body">
                                    @if (!string.IsNullOrWhiteSpace(item.Code))
                                    {
                                        <small class="product-code">@item.Code</small>
                                    }

                                    <h5>@item.Name</h5>
                                    <p class="brand">@item.Brand</p>

                                    <div class="frame-specs">
                                        @if (!string.IsNullOrWhiteSpace(item.Shape))
                                        {
                                            <span class="spec-chip">@item.Shape</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(item.Material))
                                        {
                                            <span class="spec-chip">@item.Material</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(item.Color))
                                        {
                                            <span class="spec-chip">@item.Color</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(item.Gender))
                                        {
                                            <span class="spec-chip">@item.Gender</span>
                                        }
                                    </div>

                                    <div class="rating">
                                        <i class="fas fa-star text-warning"></i>
                                        <i class="fas fa-star text-warning"></i>
                                        <i class="fas fa-star text-warning"></i>
                                        <i class="fas fa-star text-warning"></i>
                                        <i class="fas fa-star-half-alt text-warning"></i>
                                        <span>(48)</span>
                                    </div>

                                    <div class="price">@item.Price.ToString("C")</div>

                                    <div class="card-actions">
                                        @if (isPatient)
                                        {
                                            @if (item.IsAvailable)
                                            {
                                                <a asp-action="BookFrame" asp-route-id="@item.Id"
                                                   class="btn btn-book">
                                                    <i class="fa fa-bookmark"></i> Book This Frame
                                                </a>
                                            }
                                            else
                                            {
                                                <button class="btn btn-secondary" disabled>
                                                    <i class="fa fa-ban"></i> Sold Out
                                                </button>
                                            }
                                        }

                                        <a asp-action="Details" asp-route-id="@item.Id"
                                           class="btn btn-outline-primary">
                                            <i class="fa fa-eye"></i> View Details
                                        </a>

                                        @if (isAdmin)
                                        {
                                            <div class="d-flex gap-2">
                                                <a asp-action="Edit" asp-route-id="@item.Id"
                                                   class="btn btn-outline-secondary btn-sm flex-fill">
                                                    <i class="fa fa-edit"></i> Edit
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.Id"
                                                   class="btn btn-outline-danger btn-sm flex-fill">
                                                    <i class="fa fa-trash"></i> Delete
                                                </a>
                                            </div>
                                        }
                                    </div>
                                </div>

                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
