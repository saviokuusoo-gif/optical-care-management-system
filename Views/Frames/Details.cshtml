@model optical_care_management_system.Models.Frame

@{
    ViewData["Title"] = "Frame Details";
    var imageUrl = string.IsNullOrWhiteSpace(Model.ImageUrl) ? "default-frame.jpg" : Model.ImageUrl;
    var availabilityText = Model.IsAvailable ? "In Stock" : "Out of Stock";
    var availabilityClass = Model.IsAvailable ? "success" : "danger";
}

<div class="row gy-3 mb-4 frame-spec-list">

    <div class="col-12">
        <div class="frame-spec-item d-flex align-items-start gap-3">
            <div class="frame-spec-icon bg-secondary bg-opacity-10 text-secondary rounded-3 p-3">
                <i class="fa-solid fa-award fa-lg"></i>
            </div>
            <div>
                <div class="text-uppercase text-muted small mb-1">Brand</div>
                <div class="fw-semibold">@Model.Brand</div>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="frame-spec-item d-flex align-items-start gap-3">
            <div class="frame-spec-icon bg-secondary bg-opacity-10 text-secondary rounded-3 p-3">
                <i class="fa-solid fa-barcode fa-lg"></i>
            </div>
            <div>
                <div class="text-uppercase text-muted small mb-1">Product Code</div>
                <div class="fw-semibold">@Model.Code</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6">
        <div class="frame-spec-item d-flex align-items-start gap-3">
            <div class="frame-spec-icon bg-secondary bg-opacity-10 text-secondary rounded-3 p-3">
                <i class="fa-solid fa-ring fa-lg"></i>
            </div>
            <div>
                <div class="text-uppercase text-muted small mb-1">Material</div>
                <div class="fw-semibold">@Model.Material</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6">
        <div class="frame-spec-item d-flex align-items-start gap-3">
            <div class="frame-spec-icon bg-secondary bg-opacity-10 text-secondary rounded-3 p-3">
                <i class="fa-solid fa-shape-square-plus fa-lg"></i>
            </div>
            <div>
                <div class="text-uppercase text-muted small mb-1">Shape</div>
                <div class="fw-semibold">@Model.Shape</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6">
        <div class="frame-spec-item d-flex align-items-start gap-3">
            <div class="frame-spec-icon bg-secondary bg-opacity-10 text-secondary rounded-3 p-3">
                <i class="fa-solid fa-droplet fa-lg"></i>
            </div>
            <div>
                <div class="text-uppercase text-muted small mb-1">Color</div>
                <div class="fw-semibold">@Model.Color</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6">
        <div class="frame-spec-item d-flex align-items-start gap-3">
            <div class="frame-spec-icon bg-secondary bg-opacity-10 text-secondary rounded-3 p-3">
                <i class="fa-solid fa-sack-dollar fa-lg"></i>
            </div>
            <div>
                <div class="text-uppercase text-muted small mb-1">Price</div>
                <div class="fw-semibold text-dark">$@Model.Price</div>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="frame-spec-item d-flex align-items-start gap-3">
            <div class="frame-spec-icon bg-secondary bg-opacity-10 text-secondary rounded-3 p-3">
                <i class="fa-solid fa-circle-check fa-lg"></i>
            </div>
            <div>
                <div class="text-uppercase text-muted small mb-1">Availability</div>
                <div class="fw-semibold text-@availabilityClass">@availabilityText</div>
            </div>
        </div>
    </div>

</div>


<div class="d-flex flex-column flex-sm-row gap-3">

    <a asp-action="Index"
       class="btn btn-outline-primary btn-lg">
        Back to Frames
    </a>

    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-outline-secondary btn-lg">
        Edit Frame
    </a>


    <!-- BOOK FRAME -->
    <form asp-controller="Frames"
          asp-action="BookFrame"
          asp-route-id="@Model.Id"
          method="post"
          class="d-inline">

        @Html.AntiForgeryToken()

        <button type="submit"
                class="btn btn-primary btn-lg btn-frame-book">
            Book Frame
        </button>

    </form>

</div>