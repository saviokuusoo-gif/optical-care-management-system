<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - optical_care_management_system</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" integrity="sha512-z3gLpd7yknf1YoNbCzqRKc4qyor8gaKU1qmn+CShxbuBusANI9QpRohGBreCFkKxLhei6S9CQXFEbbKuqLg0DA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/patient-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/optical_care_management_system.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/print.css" asp-append-version="true" />
    <style>
        :root {
            --brand-blue: #0F2D5C;
            --brand-sky: #1E88E5;
            --brand-accent: #F5F7FA;
            --card-bg: #ffffff;
            --text-muted: #65748b;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--brand-accent);
            color: #1f2937;
        }

        .navbar-custom {
            background: linear-gradient(135deg, #0F2D5C 0%, #13396C 100%);
        }

        .navbar-custom .nav-link,
        .navbar-custom .navbar-brand,
        .navbar-custom .form-control {
            color: #ffffff !important;
        }

        .navbar-custom .nav-link:hover,
        .navbar-custom .navbar-brand:hover,
        .navbar-custom .btn-link:hover {
            color: #cbd5e1 !important;
        }

        .navbar-custom .form-control {
            background: rgba(255,255,255,0.12);
            border: none;
            color: #ffffff;
        }

        .navbar-custom .form-control::placeholder {
            color: rgba(255,255,255,0.72);
        }

        .navbar-custom .form-control:focus {
            box-shadow: 0 0 0 0.15rem rgba(30,136,229,0.26);
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom shadow-sm mb-3">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-glasses fa-lg me-2"></i>
                    <span class="fw-semibold">Optical Care</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav align-items-center me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Frames" asp-action="Index">Frames</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Admin Panel
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="adminDropdown">
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard">Dashboard</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Patients">Patients</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Doctors">Doctors</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Appointments">Appointments</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="ExaminationRecords">Examination Records</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Prescriptions">Prescriptions</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Inventory">Inventory</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="FrameBookings">Frame Bookings</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Reports">Reports</a></li>
                                    </ul>
                                </li>
                            }
                            else if (User.IsInRole("Patient"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Patient" asp-action="Dashboard">My Dashboard</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Frames" asp-action="MyBookings">My Frame Bookings</a>
                                </li>
                            }
                        }
                    </ul>
                    <form class="d-flex align-items-center mb-3 mb-lg-0 me-3" role="search" method="get" asp-controller="Frames" asp-action="Index">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white border-0"><i class="fa-solid fa-magnifying-glass"></i></span>
                            <input class="form-control rounded-end" type="search" name="search" placeholder="Search frames" aria-label="Search frames" />
                        </div>
                    </form>
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-link nav-link text-white p-0">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        @if (TempData["Error"] is not null)
        {
            <div class="alert alert-danger alert-dismissible fade show no-print mt-3" role="alert">
                <i class="fa fa-triangle-exclamation me-1"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - optical_care_management_system - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
