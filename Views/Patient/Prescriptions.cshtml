@model IEnumerable<optical_care_management_system.Models.Prescription>

@{
    ViewData["Title"] = "My Optical Prescriptions - Patient Portal";
    var prescriptions = Model?.ToList() ?? new List<optical_care_management_system.Models.Prescription>();
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="fa-solid fa-file-prescription text-success me-2"></i>My Optical Prescriptions & Medications
            </h2>
            <p class="text-muted mb-0">View optical lens prescriptions, doctor medication advice, and print official slips.</p>
        </div>
        <a asp-controller="Patient" asp-action="Dashboard" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to Dashboard
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden bg-white">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background: linear-gradient(135deg, #0F2D5C 0%, #163d7a 100%); color: #ffffff;">
                    <tr>
                        <th class="py-3 ps-4" style="font-weight: 600;">Rx Date</th>
                        <th class="py-3" style="font-weight: 600;">Prescribing Doctor</th>
                        <th class="py-3" style="font-weight: 600;">Lens Type</th>
                        <th class="py-3" style="font-weight: 600;">Left Eye (OS)</th>
                        <th class="py-3" style="font-weight: 600;">Right Eye (OD)</th>
                        <th class="py-3" style="font-weight: 600;">Status</th>
                        <th class="py-3" style="font-weight: 600;">Medication / Advice</th>
                        <th class="py-3 pe-4 text-end no-print" style="font-weight: 600; min-width: 140px;">Print Slip</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!prescriptions.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-file-circle-xmark fa-3x mb-3 text-secondary d-block"></i>
                                <h5 class="fw-bold text-dark">No Prescriptions Issued Yet</h5>
                                <p class="small text-muted mb-0">Your prescriptions will appear here once your optometrist completes your eye examination.</p>
                            </td>
                        </tr>
                    }
                    @foreach (var item in prescriptions)
                    {
                        <tr>
                            <td class="ps-4">
                                <strong>@item.PrescriptionDate.ToString("dd MMM yyyy")</strong>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="fa-solid fa-user-doctor text-info me-1"></i>Dr. @(item.Doctor?.FullName ?? "-")
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-2 py-1">
                                    @item.LensType
                                </span>
                            </td>
                            <td><code>@item.LeftEye</code></td>
                            <td><code>@item.RightEye</code></td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success px-3 py-1 rounded-pill">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-3 py-1 rounded-pill">Archived</span>
                                }
                            </td>
                            <td>
                                <small class="text-muted">@(string.IsNullOrWhiteSpace(item.Notes) ? "Standard corrective wear." : item.Notes)</small>
                            </td>
                            <td class="pe-4 text-end no-print">
                                <a asp-action="PrintPrescription" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold" title="Print Official Prescription Slip" target="_blank">
                                    <i class="fa-solid fa-print me-1"></i> Print Slip
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
