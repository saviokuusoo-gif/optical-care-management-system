@model IEnumerable<optical_care_management_system.Models.ExaminationRecord>

@{
    ViewData["Title"] = "Eye Examinations - Doctor Portal";
    var records = Model.ToList();
}

<div class="container mt-4 mb-5">
    @if (TempData["Success"] is not null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 rounded-3" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="fa-solid fa-microscope text-primary me-2"></i>Eye Examination Records (Cabbirka)
            </h2>
            <p class="text-muted mb-0">Review diagnostic measurements performed for your patients, then prescribe necessary optical lenses or medications.</p>
        </div>
        <div>
            <a asp-action="ExaminationRecordForm" class="btn btn-primary rounded-pill px-4 shadow-sm fw-semibold">
                <i class="fa-solid fa-plus me-1"></i> New Examination
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden bg-white">
        <div class="card-header bg-white border-bottom p-3">
            <div class="row align-items-center g-3">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa fa-search"></i></span>
                        <input type="text" class="form-control bg-light border-start-0 ps-0" placeholder="Search by patient name or measurement..." id="examSearch" />
                    </div>
                </div>
                <div class="col-md-6 text-md-end text-muted small">
                    <span class="badge bg-light text-dark border px-3 py-2 fs-7 rounded-pill">
                        <i class="fa-solid fa-eye me-1 text-primary"></i> Total: @records.Count Examinations
                    </span>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background: linear-gradient(135deg, #0F2D5C 0%, #163d7a 100%); color: #ffffff;">
                    <tr>
                        <th class="py-3 ps-4" style="font-weight: 600;">Patient</th>
                        <th class="py-3" style="font-weight: 600;">Exam Date</th>
                        <th class="py-3" style="font-weight: 600;">Left Eye (OS)</th>
                        <th class="py-3" style="font-weight: 600;">Right Eye (OD)</th>
                        <th class="py-3" style="font-weight: 600;">Acuity</th>
                        <th class="py-3" style="font-weight: 600;">Pressure (IOP)</th>
                        <th class="py-3" style="font-weight: 600;">Notes</th>
                        <th class="py-3 pe-4 text-end no-print" style="font-weight: 600; min-width: 260px;">Clinical Actions</th>
                    </tr>
                </thead>
                <tbody id="examTable">
                    @if (!records.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-5">
                                <i class="fa-solid fa-notes-medical fa-3x mb-3 text-secondary d-block"></i>
                                <h5 class="fw-bold text-dark">No Examination Records Found</h5>
                                <p class="small text-muted mb-3">No eye measurements are registered for your patient queue yet.</p>
                            </td>
                        </tr>
                    }
                    @foreach (var exam in records)
                    {
                        var hasRx = exam.Prescriptions != null && exam.Prescriptions.Any();

                        <tr class="exam-row">
                            <td class="ps-4">
                                <div class="fw-bold text-dark">@(exam.Patient?.FullName ?? "Unknown")</div>
                                <small class="text-muted"><i class="fa-solid fa-phone text-success me-1"></i>@(exam.Patient?.Phone ?? "-")</small>
                            </td>
                            <td>
                                <span class="small text-dark">@exam.ExamDate.ToString("dd MMM yyyy")</span>
                            </td>
                            <td><code>@exam.LeftEye</code></td>
                            <td><code>@exam.RightEye</code></td>
                            <td><span class="badge bg-light text-dark border">@exam.VisualAcuity</span></td>
                            <td><span class="badge bg-light text-dark border">@exam.EyePressure</span></td>
                            <td><small class="text-muted">@(string.IsNullOrWhiteSpace(exam.Notes) ? "-" : exam.Notes)</small></td>
                            <td class="pe-4 text-end no-print" style="white-space: nowrap;">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="PrescriptionForm" asp-route-patientId="@exam.PatientId" asp-route-examId="@exam.Id" class="btn btn-sm btn-success rounded-pill px-3 fw-bold action-btn" title="Prescribe Medication & Optical Lenses">
                                        <i class="fa-solid fa-file-prescription me-1"></i> Prescribe
                                    </a>
                                    <a asp-action="PrintExamination" asp-route-id="@exam.Id" class="btn btn-sm btn-outline-primary rounded-pill px-2 action-btn" title="Print Examination Report">
                                        <i class="fa-solid fa-print"></i>
                                    </a>
                                    <a asp-action="ExaminationRecordForm" asp-route-id="@exam.Id" class="btn btn-sm btn-outline-warning rounded-pill px-2 action-btn" title="Edit Exam">
                                        <i class="fa-solid fa-edit"></i>
                                    </a>
                                    <form asp-action="DeleteExaminationRecord" asp-route-id="@exam.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this examination record?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2 action-btn" title="Delete">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="card-footer bg-white py-3 border-top d-flex justify-content-between align-items-center text-muted small">
            <div>Showing assigned examination measurements</div>
            <div>Doctor Clinical Workspace</div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("examSearch")?.addEventListener("keyup", function () {
            const val = this.value.toLowerCase().trim();
            document.querySelectorAll("#examTable tr.exam-row").forEach(row => {
                row.style.display = row.innerText.toLowerCase().includes(val) ? "" : "none";
            });
        });
    </script>
}
