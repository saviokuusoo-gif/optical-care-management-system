@model IEnumerable<optical_care_management_system.Models.Prescription>

@{
    ViewData["Title"] = "Prescriptions & Medications - Doctor Portal";
    var prescriptions = Model.ToList();
}

<div class="container mt-4 mb-5">
    @if (TempData["Success"] is not null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 rounded-3" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="fa-solid fa-file-prescription text-success me-2"></i>Prescriptions & Medication Records
            </h2>
            <p class="text-muted mb-0">Manage issued optical prescriptions, eye drops, medications, and print official slips.</p>
        </div>
        <div>
            <a asp-action="PrescriptionForm" class="btn btn-success rounded-pill px-4 shadow-sm fw-semibold">
                <i class="fa-solid fa-plus me-1"></i> Write New Prescription
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden bg-white">
        <div class="card-header bg-white border-bottom p-3">
            <div class="row align-items-center g-3">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa fa-search"></i></span>
                        <input type="text" class="form-control bg-light border-start-0 ps-0" placeholder="Search by patient name, lens type, or medication..." id="prescriptionSearch" />
                    </div>
                </div>
                <div class="col-md-6 text-md-end text-muted small">
                    <span class="badge bg-light text-dark border px-3 py-2 fs-7 rounded-pill">
                        <i class="fa-solid fa-file-prescription me-1 text-success"></i> Total: @prescriptions.Count Prescriptions Written
                    </span>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background: linear-gradient(135deg, #0F2D5C 0%, #163d7a 100%); color: #ffffff;">
                    <tr>
                        <th class="py-3 ps-4" style="font-weight: 600;">Rx #</th>
                        <th class="py-3" style="font-weight: 600;">Patient</th>
                        <th class="py-3" style="font-weight: 600;">Date</th>
                        <th class="py-3" style="font-weight: 600;">Lens Type</th>
                        <th class="py-3" style="font-weight: 600;">Left Eye (OS)</th>
                        <th class="py-3" style="font-weight: 600;">Right Eye (OD)</th>
                        <th class="py-3" style="font-weight: 600;">Status</th>
                        <th class="py-3" style="font-weight: 600;">Medication / Instructions</th>
                        <th class="py-3 pe-4 text-end no-print" style="font-weight: 600; min-width: 200px;">Actions</th>
                    </tr>
                </thead>
                <tbody id="prescriptionTable">
                    @if (!prescriptions.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-5">
                                <i class="fa-solid fa-file-circle-xmark fa-3x mb-3 text-secondary d-block"></i>
                                <h5 class="fw-bold text-dark">No Prescriptions Written Yet</h5>
                                <p class="small text-muted mb-3">Click <strong>Write New Prescription</strong> to issue your first optical prescription.</p>
                            </td>
                        </tr>
                    }
                    @foreach (var p in prescriptions)
                    {
                        <tr class="rx-row">
                            <td class="ps-4">
                                <span class="badge bg-light text-dark border">#RX-@p.Id.ToString("D4")</span>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@(p.Patient?.FullName ?? "Unknown")</div>
                                <small class="text-muted"><i class="fa-solid fa-phone text-success me-1"></i>@(p.Patient?.Phone ?? "-")</small>
                            </td>
                            <td>
                                <span class="small text-dark">@p.PrescriptionDate.ToString("dd MMM yyyy")</span>
                            </td>
                            <td>
                                <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-2 py-1">
                                    @p.LensType
                                </span>
                            </td>
                            <td><code>@p.LeftEye</code></td>
                            <td><code>@p.RightEye</code></td>
                            <td>
                                @if (p.IsActive)
                                {
                                    <span class="badge bg-success px-3 py-1 rounded-pill">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-3 py-1 rounded-pill">Archived</span>
                                }
                            </td>
                            <td>
                                <small class="text-muted" style="max-width: 200px; display: inline-block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                    @(string.IsNullOrWhiteSpace(p.Notes) ? "-" : p.Notes)
                                </small>
                            </td>
                            <td class="pe-4 text-end no-print" style="white-space: nowrap;">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="PrintPrescription" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold action-btn" title="Print Official Prescription Slip" target="_blank">
                                        <i class="fa-solid fa-print me-1"></i> Print
                                    </a>
                                    <a asp-action="PrescriptionForm" asp-route-id="@p.Id" class="btn btn-sm btn-outline-warning rounded-pill px-2 action-btn" title="Edit">
                                        <i class="fa-solid fa-edit"></i>
                                    </a>
                                    <form asp-action="DeletePrescription" asp-route-id="@p.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this prescription?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2 action-btn" title="Delete">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="card-footer bg-white py-3 border-top d-flex justify-content-between align-items-center text-muted small">
            <div>Showing issued optical prescriptions</div>
            <div>Doctor Clinical Workspace</div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("prescriptionSearch")?.addEventListener("keyup", function () {
            const val = this.value.toLowerCase().trim();
            document.querySelectorAll("#prescriptionTable tr.rx-row").forEach(row => {
                row.style.display = row.innerText.toLowerCase().includes(val) ? "" : "none";
            });
        });
    </script>
}
