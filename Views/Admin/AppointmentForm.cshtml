@model optical_care_management_system.Models.Appointment

@{
    ViewData["Title"] = Model.Id == 0 ? "Add Appointment" : "Edit Appointment";
}

<div class="container mt-4">

    <h2>@ViewData["Title"]</h2>

    <form asp-action="AppointmentForm" method="post">

        @Html.AntiForgeryToken()

        <input asp-for="Id" type="hidden" />


        <div class="mb-3">
            <label class="form-label">Patient</label>

            <select asp-for="PatientId"
                    asp-items="ViewBag.Patients"
                    class="form-select">

                <option value="">-- Select Patient --</option>

            </select>

            <span asp-validation-for="PatientId"
                  class="text-danger"></span>
        </div>



        <div class="mb-3">
            <label class="form-label">Doctor</label>

            <select asp-for="DoctorId"
                    asp-items="ViewBag.Doctors"
                    class="form-select">

                <option value="">-- Select Doctor --</option>

            </select>

            <span asp-validation-for="DoctorId"
                  class="text-danger"></span>
        </div>



        <div class="mb-3">
            <label asp-for="AppointmentDate"
                   class="form-label"></label>

            <input asp-for="AppointmentDate"
                   type="datetime-local"
                   class="form-control" />

            <span asp-validation-for="AppointmentDate"
                  class="text-danger"></span>
        </div>

<div class="mb-3">
    <label asp-for="TimeSlot" class="form-label"></label>

    <input asp-for="TimeSlot"
           class="form-control"
           placeholder="Example: 10:00 AM" />

    <span asp-validation-for="TimeSlot"
          class="text-danger"></span>
</div>

        <div class="mb-3">
            <label asp-for="Status"
                   class="form-label"></label>

            <select asp-for="Status"
                    class="form-select">

                <option value="Pending">Pending</option>
                <option value="Approved">Approved</option>
                <option value="Completed">Completed</option>
                <option value="Cancelled">Cancelled</option>

            </select>

            <span asp-validation-for="Status"
                  class="text-danger"></span>
        </div>



        <button type="submit" class="btn btn-primary">
            Save Appointment
        </button>


        <a asp-action="Appointments"
           class="btn btn-secondary">
            Cancel
        </a>


    </form>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}a