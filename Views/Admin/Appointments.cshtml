@model IEnumerable<optical_care_management_system.Models.Appointment>

@{
    ViewData["Title"] = "Appointments";
    var appointments = Model?.ToList() ?? new List<optical_care_management_system.Models.Appointment>();
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="text-primary"><i class="bi bi-calendar2-week"></i> Appointments</h2>
            <p class="text-muted mb-0">Review and manage scheduled appointments. Total: @appointments.Count</p>
        </div>
        <a asp-action="AppointmentForm" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> New Appointment
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show no-print" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (appointments.Any())
    {
        <div class="card shadow">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Patient</th>
                                <th>Doctor</th>
                                <th>Status</th>
                                <th class="no-print">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appointment in appointments)
                            {
                                var statusText = appointment.Status.ToString();
                                var badgeClass = statusText.ToLower() switch
                                {
                                    "approved" => "bg-success",
                                    "canceled" => "bg-danger",
                                    _ => "bg-warning"
                                };

                                <tr>
                                    <td>@appointment.AppointmentDate.ToString("dd/MM/yyyy")</td>
                                    <td>@appointment.TimeSlot</td>
                                    <td>@(appointment.Patient?.FullName ?? "Unknown Patient")</td>
                                    <td>
                                        @if (appointment.Doctor is not null)
                                        {
                                            @appointment.Doctor.FullName
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Not assigned</span>
                                        }
                                    </td>
                                    <td><span class="badge @badgeClass text-white">@statusText</span></td>
                                    <td class="no-print">
                                        @if (appointment.Status == optical_care_management_system.Models.AppointmentStatus.Pending)
                                        {
                                            <form asp-action="UpdateAppointmentStatus" asp-route-id="@appointment.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="status" value="Approved" />
                                                <button type="submit" class="btn btn-sm btn-success">
                                                    <i class="bi bi-check-circle"></i> Approve
                                                </button>
                                            </form>
                                            <form asp-action="UpdateAppointmentStatus" asp-route-id="@appointment.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="status" value="Canceled" />
                                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to cancel this appointment?')">
                                                    <i class="bi bi-x-circle"></i> Cancel
                                                </button>
                                            </form>
                                        }
                                        <a asp-action="AppointmentForm" asp-route-id="@appointment.Id" class="btn btn-sm btn-warning">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <form asp-action="DeleteAppointment" asp-route-id="@appointment.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this appointment?')">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            There are no appointments to display at this time.
        </div>
    }
</div>
