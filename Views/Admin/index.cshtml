@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-4">
    <!-- Guryaha Soo dhawaynta -->
    <div class="p-5 mb-4 bg-dark text-white rounded-3 shadow-sm">
        <div class="container-fluid py-3">
            <h1 class="display-5 fw-bold"><i class="bi bi-shield-lock"></i> Maamulka Sare (Admin Dashboard)</h1>
            <p class="col-md-8 fs-5 text-light-50">Ku soo dhawaada nidaamka maamulka ee Smart Optical Care System. Halkan waxaad si toos ah uga maamuli kartaa ballamaha ay bukaannadu codsadeen.</p>
        </div>
    </div>

    <!-- Kaadhka weyn ee shaqada -->
    <div class="row justify-content-center text-center">
        <div class="col-md-6">
            <div class="card h-100 shadow-sm border border-light p-4">
                <div class="card-body">
                    <div class="text-warning fs-1 mb-2"><i class="bi bi-calendar-check"></i></div>
                    <h3>Maamulka Ballamaha</h3>
                    <p class="text-muted text-wrap">La soco, aqbal, ama baajji dhammaan ballamaha ay codsadeen bukaannadu.</p>
                    <a asp-controller="Admin" asp-action="Appointments" class="btn btn-warning text-dark fw-bold btn-lg mt-3">
                        Fiiri & Maamul Ballamaha
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>