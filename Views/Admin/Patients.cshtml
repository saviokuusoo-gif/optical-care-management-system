@model IEnumerable<optical_care_management_system.Models.Patient>

@{
    ViewData["Title"] = "Patients Management";
    var totalPatients = Model.Count();
}

<div class="container mt-4">

    @if (TempData["Success"] is not null)
    {
        <div class="alert alert-success alert-dismissible fade show no-print" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">

        <div>
            <h2>Patients Management</h2>
            <p class="text-muted mb-0">
                Total Patients: @totalPatients
            </p>
        </div>

        <a asp-action="PatientForm" class="btn btn-primary">
            <i class="fa fa-user-plus"></i>
            Add New Patient
        </a>

    </div>


    <div class="card shadow">

        <div class="card-body">

            <div class="mb-3 no-print">

                <input type="text"
                       class="form-control"
                       placeholder="Search patient..."
                       id="patientSearch">

            </div>


            <table class="table table-hover">

                <thead class="table-dark">

                    <tr>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th width="200" class="text-end no-print">Actions</th>
                    </tr>

                </thead>


                <tbody id="patientTable">

                @foreach (var patient in Model)
                {
                    <tr>

                        <td>
                            @patient.FullName
                        </td>

                        <td>
                            @patient.Email
                        </td>

                        <td>
                            @patient.Phone
                        </td>

                        <td class="text-end no-print">

                            <a asp-action="PatientDetails"
                               asp-route-id="@patient.Id"
                               class="btn btn-sm btn-info">

                                <i class="fa fa-eye"></i>
                                View

                            </a>


                            <a asp-action="PatientForm"
                               asp-route-id="@patient.Id"
                               class="btn btn-sm btn-warning">

                                <i class="fa fa-edit"></i>
                                Edit

                            </a>


                            <form asp-action="DeletePatient"
                                  asp-route-id="@patient.Id"
                                  method="post"
                                  style="display:inline">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-sm btn-danger"
                                        onclick="return confirm('Delete this patient?')">

                                    <i class="fa fa-trash"></i>
                                    Delete

                                </button>

                            </form>

                        </td>
                    </tr>
                }

                </tbody>

            </table>

        </div>

    </div>

</div>


@section Scripts {

<script>

document.getElementById("patientSearch")
.addEventListener("keyup", function(){

    let value = this.value.toLowerCase();

    let rows = document.querySelectorAll("#patientTable tr");


    rows.forEach(row => {

        row.style.display =
        row.innerText.toLowerCase().includes(value)
        ? ""
        : "none";

    });

});

</script>

}
