@model IEnumerable<optical_care_management_system.Models.Doctor>

@{
    ViewData["Title"] = "Doctors Management - Optical Care";
    var doctors = Model.ToList();
    var totalDoctors = doctors.Count;
    var totalExams = doctors.Sum(d => d.ExaminationRecords?.Count ?? 0);
    var totalRx = doctors.Sum(d => d.Prescriptions?.Count ?? 0);
}

<div class="container mt-4">
    <!-- Flash Messages -->
    @if (TempData["Success"] is not null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 rounded-3" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="fa-solid fa-user-doctor text-primary me-2"></i>Doctors & Medical Staff
            </h2>
            <p class="text-muted mb-0">Manage certified optometrists, clinical staff accounts, and track their examination records.</p>
        </div>
        <div>
            <a asp-action="DoctorForm" class="btn btn-primary rounded-pill px-4 shadow-sm fw-semibold">
                <i class="fa-solid fa-user-plus me-1"></i> Add New Doctor
            </a>
        </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4 col-sm-6">
            <div class="card shadow-sm border-0 rounded-3 bg-white p-3 border-start border-4 border-primary">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Active Doctors</div>
                        <div class="fs-2 fw-bold text-dark">@totalDoctors</div>
                    </div>
                    <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-circle">
                        <i class="fa-solid fa-user-doctor fa-xl"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-sm-6">
            <div class="card shadow-sm border-0 rounded-3 bg-white p-3 border-start border-4 border-info">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Completed Eye Exams</div>
                        <div class="fs-2 fw-bold text-dark">@totalExams</div>
                    </div>
                    <div class="p-3 bg-info bg-opacity-10 text-info rounded-circle">
                        <i class="fa-solid fa-eye fa-xl"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-sm-6">
            <div class="card shadow-sm border-0 rounded-3 bg-white p-3 border-start border-4 border-success">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Prescriptions Issued</div>
                        <div class="fs-2 fw-bold text-dark">@totalRx</div>
                    </div>
                    <div class="p-3 bg-success bg-opacity-10 text-success rounded-circle">
                        <i class="fa-solid fa-file-prescription fa-xl"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Doctors Card -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden bg-white">
        <!-- Search Toolbar -->
        <div class="card-header bg-white border-bottom p-3">
            <div class="row align-items-center g-3">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa fa-search"></i></span>
                        <input type="text" class="form-control bg-light border-start-0 ps-0" placeholder="Search doctor by name, specialty, license number, or email..." id="doctorSearch" />
                    </div>
                </div>
                <div class="col-md-6 text-md-end text-muted small">
                    <span id="doctorCountBadge" class="badge bg-light text-dark border px-3 py-2 fs-7 rounded-pill">
                        <i class="fa-solid fa-user-doctor me-1 text-primary"></i> Showing @totalDoctors Doctors
                    </span>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background: linear-gradient(135deg, #0F2D5C 0%, #163d7a 100%); color: #ffffff;">
                    <tr>
                        <th class="py-3 ps-4" style="font-weight: 600;">Doctor</th>
                        <th class="py-3" style="font-weight: 600;">Specialty</th>
                        <th class="py-3" style="font-weight: 600;">Login Account</th>
                        <th class="py-3" style="font-weight: 600;">Contact</th>
                        <th class="py-3" style="font-weight: 600;">Clinical Stats</th>
                        <th class="py-3 pe-4 text-end no-print" style="font-weight: 600; min-width: 240px;">Actions</th>
                    </tr>
                </thead>
                <tbody id="doctorTable">
                    @if (!doctors.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-user-doctor fa-3x mb-3 text-secondary d-block"></i>
                                <h5 class="fw-bold text-dark">No Doctors Registered</h5>
                                <p class="small text-muted mb-3">Add specialist optometrists to assign patient appointments.</p>
                                <a asp-action="DoctorForm" class="btn btn-sm btn-primary rounded-pill px-3">
                                    <i class="fa-solid fa-plus me-1"></i> Add Doctor
                                </a>
                            </td>
                        </tr>
                    }
                    @foreach (var doctor in doctors)
                    {
                        var initials = string.Join("", (doctor.FullName ?? "DR").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0])).ToUpper();

                        <tr class="doctor-row">
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="avatar-circle-doctor shadow-sm">
                                        @initials
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">@doctor.FullName</div>
                                        <small class="text-muted">License: <code>@doctor.LicenseNumber</code></small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-2 rounded-pill fw-semibold">
                                    <i class="fa-solid fa-stethoscope me-1"></i>@doctor.Specialty
                                </span>
                            </td>
                            <td>
                                @if (doctor.UserAccount != null)
                                {
                                    <span class="badge bg-light text-dark border px-2 py-1">
                                        <i class="fa-solid fa-user-lock text-info me-1"></i>@doctor.UserAccount.Username
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-secondary border">No login account</span>
                                }
                            </td>
                            <td>
                                <div class="small">
                                    <div><i class="fa-solid fa-phone text-success me-1"></i>@doctor.Phone</div>
                                    <div class="text-muted"><i class="fa-regular fa-envelope me-1"></i>@doctor.Email</div>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex flex-column gap-1 small">
                                    <span class="badge bg-light text-dark border text-start">
                                        <i class="fa-solid fa-eye text-info me-1"></i>@(doctor.ExaminationRecords?.Count ?? 0) Exams Done
                                    </span>
                                    <span class="badge bg-light text-dark border text-start">
                                        <i class="fa-solid fa-file-prescription text-success me-1"></i>@(doctor.Prescriptions?.Count ?? 0) Prescriptions
                                    </span>
                                </div>
                            </td>
                            <td class="pe-4 text-end no-print" style="white-space: nowrap;">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="DoctorDetails" asp-route-id="@doctor.Id" class="btn btn-sm btn-outline-info rounded-pill px-3 fw-semibold action-btn" title="View Doctor Work, Treated Patients, and Exams">
                                        <i class="fa-solid fa-chart-line me-1"></i> Activity
                                    </a>
                                    <a asp-action="DoctorForm" asp-route-id="@doctor.Id" class="btn btn-sm btn-outline-warning rounded-pill px-3 fw-semibold action-btn" title="Edit Doctor Profile & Login Account">
                                        <i class="fa-solid fa-edit me-1"></i> Edit
                                    </a>
                                    <form asp-action="DeleteDoctor" asp-route-id="@doctor.Id" method="post" class="d-inline" onsubmit="return confirm('Delete doctor @doctor.FullName?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2 action-btn" title="Delete Doctor">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="card-footer bg-white py-3 border-top d-flex justify-content-between align-items-center text-muted small">
            <div>Showing medical staff records</div>
            <div>Optical Care Management System</div>
        </div>
    </div>
</div>

<style>
    .avatar-circle-doctor {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.85rem;
        flex-shrink: 0;
    }
</style>

@section Scripts {
    <script>
        document.getElementById("doctorSearch")?.addEventListener("keyup", function () {
            const val = this.value.toLowerCase().trim();
            const rows = document.querySelectorAll("#doctorTable tr.doctor-row");
            let visibleCount = 0;

            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                if (text.includes(val)) {
                    row.style.display = "";
                    visibleCount++;
                } else {
                    row.style.display = "none";
                }
            });

            const badge = document.getElementById("doctorCountBadge");
            if (badge) {
                badge.innerHTML = `<i class="fa-solid fa-user-doctor me-1 text-primary"></i> Showing ${visibleCount} Doctors`;
            }
        });
    </script>
}
