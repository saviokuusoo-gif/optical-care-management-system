@model optical_care_management_system.Models.Patient

@{
    ViewData["Title"] = "Patient Details";
}


<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">

        <div>
            <h2 class="mb-0">Patient Details</h2>
            <p class="text-muted mb-0">@Model.FullName</p>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="PatientForm" asp-route-id="@Model.Id" class="btn btn-warning">
                <i class="fa fa-edit"></i> Edit
            </a>
            <a asp-action="Patients" class="btn btn-secondary">
                Back
            </a>
        </div>

    </div>



    <!-- Patient Information -->

    <div class="card shadow mb-4">

        <div class="card-header bg-primary text-white">

            <h5 class="mb-0">
                Patient Information
            </h5>

        </div>


        <div class="card-body">


            <div class="row">

                <div class="col-md-6">

                    <p>
                        <strong>Name:</strong>
                        @Model.FullName
                    </p>


                    <p>
                        <strong>Email:</strong>
                        @Model.Email
                    </p>


                </div>



                <div class="col-md-6">

                    <p>
                        <strong>Phone:</strong>
                        @Model.Phone
                    </p>


                    <p>
                        <strong>Created Date:</strong>
                        @Model.CreatedAt.ToString("dd/MM/yyyy")
                    </p>


                </div>


            </div>


        </div>

    </div>




    <!-- Appointments -->

    <div class="card shadow mb-4">


        <div class="card-header bg-success text-white">

            <h5 class="mb-0">
                Appointments
            </h5>

        </div>


        <div class="card-body">


            @if (Model.Appointments != null && Model.Appointments.Any())
            {

                <table class="table table-bordered">

                    <thead>

                        <tr>

                            <th>
                                Date
                            </th>

                            <th>
                                Status
                            </th>

                        </tr>

                    </thead>


                    <tbody>


                    @foreach (var appointment in Model.Appointments)
                    {

                        <tr>

                            <td>
                                @appointment.AppointmentDate.ToString("dd/MM/yyyy")
                            </td>


                            <td>
                                @appointment.Status
                            </td>


                        </tr>

                    }


                    </tbody>


                </table>

            }
            else
            {

                <p class="text-muted">
                    No appointments found.
                </p>

            }


        </div>


    </div>
        <!-- Examination Records -->

    <div class="card shadow mb-4">

        <div class="card-header bg-info text-white">

            <h5 class="mb-0">
                Examination Records
            </h5>

        </div>


        <div class="card-body">


            @if (Model.ExaminationRecords != null && Model.ExaminationRecords.Any())
            {

                <table class="table table-bordered">

                    <thead>

                        <tr>

                            <th>
                                Exam Date
                            </th>

                            <th>
                                Notes
                            </th>

                        </tr>

                    </thead>


                    <tbody>


                    @foreach (var record in Model.ExaminationRecords)
                    {

                        <tr>

                            <td>
                                @record.ExamDate.ToString("dd/MM/yyyy")
                            </td>


                            <td>
                                @record.Notes
                            </td>


                        </tr>

                    }


                    </tbody>


                </table>

            }
            else
            {

                <p class="text-muted">
                    No examination records found.
                </p>

            }


        </div>

    </div>




    <!-- Prescriptions -->

    <div class="card shadow mb-4">


        <div class="card-header bg-warning">

            <h5 class="mb-0">
                Prescriptions
            </h5>

        </div>



        <div class="card-body">


            @if (Model.Prescriptions != null && Model.Prescriptions.Any())
            {

                <table class="table table-bordered">


                    <thead>

                        <tr>

                            <th>
                                Date
                            </th>

                            <th>
                                Lens Type
                            </th>

                            <th>
                                Left Eye
                            </th>

                            <th>
                                Right Eye
                            </th>


                        </tr>

                    </thead>



                    <tbody>


                    @foreach (var prescription in Model.Prescriptions)
                    {

                        <tr>


                            <td>
                                @prescription.PrescriptionDate.ToString("dd/MM/yyyy")
                            </td>


                            <td>
                                @prescription.LensType
                            </td>


                            <td>
                                @prescription.LeftEye
                            </td>


                            <td>
                                @prescription.RightEye
                            </td>


                        </tr>

                    }


                    </tbody>


                </table>

            }
            else
            {

                <p class="text-muted">
                    No prescriptions found.
                </p>

            }


        </div>


    </div>



</div>