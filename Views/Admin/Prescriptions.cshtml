@model IEnumerable<optical_care_management_system.Models.Prescription>

@{
    ViewData["Title"] = "Prescriptions";
    var prescriptions = Model?.ToList() ?? new List<optical_care_management_system.Models.Prescription>();
}

<div class="container mt-4">

    @if (TempData["Success"] is not null)
    {
        <div class="alert alert-success alert-dismissible fade show no-print" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2>Prescriptions</h2>
            <p class="text-muted mb-0">Total Prescriptions: @prescriptions.Count</p>
        </div>
        <a asp-action="PrescriptionForm" class="btn btn-primary">
            <i class="fa fa-plus"></i> Add New Prescription
        </a>
    </div>

    <div class="card shadow">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Patient</th>
                            <th>Doctor</th>
                            <th>Date</th>
                            <th>Lens Type</th>
                            <th>Left Eye</th>
                            <th>Right Eye</th>
                            <th>Status</th>
                            <th>Notes</th>
                            <th width="170" class="text-end no-print">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!prescriptions.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted py-4">
                                    No prescriptions yet.
                                </td>
                            </tr>
                        }
                        @foreach (var item in prescriptions)
                        {
                            <tr>
                                <td>@(item.Patient?.FullName ?? "-")</td>
                                <td>@(item.Doctor?.FullName ?? "-")</td>
                                <td>@item.PrescriptionDate.ToString("dd/MM/yyyy")</td>
                                <td>@item.LensType</td>
                                <td>@item.LeftEye</td>
                                <td>@item.RightEye</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td>@item.Notes</td>
                                <td class="text-end no-print">
                                    <a asp-action="PrescriptionForm" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                        <i class="fa fa-edit"></i> Edit
                                    </a>
                                    <form asp-action="DeletePrescription" asp-route-id="@item.Id" method="post" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete this prescription?')">
                                            <i class="fa fa-trash"></i> Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
